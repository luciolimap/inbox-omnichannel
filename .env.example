# Copie para .env e ajuste. O .env nao vai para o repositorio.
POSTGRES_PASSWORD=inbox_dev
JWT_SECRET=troque-este-segredo-por-no-minimo-32-caracteres
INTERNAL_TOKEN=token-interno-de-desenvolvimento

# Token do bot criado no @BotFather. Sem ele o canal Telegram fica desligado
# e apenas os canais simulados funcionam.
TELEGRAM_BOT_TOKEN=
# Registrado no setWebhook como secret_token: o Telegram devolve esse valor
# no header X-Telegram-Bot-Api-Secret-Token e o gateway recusa quem nao traz.
TELEGRAM_WEBHOOK_SECRET=

# Vazio deixa o inbox no modo de demonstracao. Em servidor exposto ponha prod,
# que e o que obriga a senha abaixo.
SPRING_PROFILES_ACTIVE=
# Senha dos dois agentes semeados. Vazia fora de producao: o core cai na senha
# de demonstracao do README. Com SPRING_PROFILES_ACTIVE=prod ela e obrigatoria.
SEED_ADMIN_PASSWORD=
